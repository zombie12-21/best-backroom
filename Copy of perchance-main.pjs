$meta
  title = BACKROOMS // Organized Survival FPS
  description = Tutorial + 16 levels + Sandbox, 49 items, 15 weapons, vault level with every item, Mother of All Entities super-boss, keep your loot between levels, 5 hidden easter eggs. Training gear never leaves the tutorial.
  header
    mode = minimal

createServerSocket = {import:server-plugin}

generateText = {import:ai-text-plugin}

